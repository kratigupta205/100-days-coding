Q69: Find the second largest element in an array.*/
#include <stdio.h>
#include <limits.h>

int main() {
    int n;

    scanf("%d", &n);

    int arr[n];

    // Input array
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int largest = INT_MIN;
    int secondLargest = INT_MIN;

    // Find largest and second largest
    for (int i = 0; i < n; i++) {

        if (arr[i] > largest) {
            secondLargest = largest;
            largest = arr[i];
        }
        else if (arr[i] > secondLargest && arr[i] != largest) {
            secondLargest = arr[i];
        }
    }

    // Print result
    if (secondLargest == INT_MIN) {
        printf("-1");
    }
    else {
        printf("%d", secondLargest);
    }

    return 0;
}
Q70: Rotate an array to the right by k positions.*/
#include <stdio.h>

int main() {
    int n, k;

    scanf("%d", &n);

    int arr[n];

    // Input array
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Input number of rotations
    scanf("%d", &k);

    // Handle k greater than n
    k = k % n;

    // Rotate k times
    for (int j = 0; j < k; j++) {

        // Store last element
        int last = arr[n - 1];

        // Shift all elements one position to right
        for (int i = n - 1; i > 0; i--) {
            arr[i] = arr[i - 1];
        }

        // Put last element at first position
        arr[0] = last;
    }

    // Print rotated array
    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);

        if (i < n - 1) {
            printf(" ");
        }
    }

    return 0;
}
