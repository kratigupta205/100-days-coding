Q27: Write a program to print the sum of the first n odd numbers.
#include <stdio.h>

int main() {
    int n, i, sum = 0;

    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        sum = sum + (2 * i - 1);
    }

    printf("%d", sum);

    return 0;
}
Q28: Write a program to print the product of even numbers from 1 to n.
#include <stdio.h>

int main() {
    int n, i, product = 1;

    scanf("%d", &n);

    for (i = 2; i <= n; i += 2) {
        product = product * i;
    }

    printf("%d", product);

    return 0;
}
