Q63: Merge two arrays.*/
#include <stdio.h>

int main() {
    int n1, n2;

    scanf("%d", &n1);

    int arr1[n1];

    for (int i = 0; i < n1; i++) {
        scanf("%d", &arr1[i]);
    }

    scanf("%d", &n2);

    int arr2[n2];

    for (int i = 0; i < n2; i++) {
        scanf("%d", &arr2[i]);
    }

    int merged[n1 + n2];

    for (int i = 0; i < n1; i++) {
        merged[i] = arr1[i];
    }

    for (int i = 0; i < n2; i++) {
        merged[n1 + i] = arr2[i];
    }

    for (int i = 0; i < n1 + n2; i++) {
        printf("%d", merged[i]);

        if (i < n1 + n2 - 1) {
            printf(" ");
        }
    }

    return 0;
}
Q64: Find the digit that occurs the most times in an integer number.*/
#include <stdio.h>

int main() {
    long long num;
    int count[10] = {0};

    scanf("%lld", &num);

    if (num == 0) {
        printf("0");
        return 0;
    }

    if (num < 0) {
        num = -num;
    }

    while (num > 0) {
        int digit = num % 10;
        count[digit]++;
        num = num / 10;
    }

    int maxCount = 0;
    int mostFrequent = 0;

    for (int i = 0; i <= 9; i++) {
        if (count[i] > maxCount) {
            maxCount = count[i];
            mostFrequent = i;
        }
    }

    printf("%d", mostFrequent);

    return 0;
}
