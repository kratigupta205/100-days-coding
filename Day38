Q75: Add two matrices.
#include <stdio.h>

int main()
{
    int rows1, cols1, rows2, cols2;
    int a[10][10], b[10][10], sum[10][10];
    int i, j;

    // Input first matrix
    scanf("%d %d", &rows1, &cols1);

    for (i = 0; i < rows1; i++)
    {
        for (j = 0; j < cols1; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    // Input second matrix
    scanf("%d %d", &rows2, &cols2);

    for (i = 0; i < rows2; i++)
    {
        for (j = 0; j < cols2; j++)
        {
            scanf("%d", &b[i][j]);
        }
    }

    // Check if addition is possible
    if (rows1 != rows2 || cols1 != cols2)
    {
        printf("Matrix addition not possible");
        return 0;
    }

    // Add matrices
    for (i = 0; i < rows1; i++)
    {
        for (j = 0; j < cols1; j++)
        {
            sum[i][j] = a[i][j] + b[i][j];
        }
    }

    // Print result
    for (i = 0; i < rows1; i++)
    {
        for (j = 0; j < cols1; j++)
        {
            printf("%d ", sum[i][j]);
        }
        printf("\n");
    }

    return 0;
}
Q76: Check if a matrix is symmetric.
#include <stdio.h>

int main()
{
    int rows, cols;
    int matrix[10][10];
    int i, j;
    int symmetric = 1;

    scanf("%d %d", &rows, &cols);

    // Input matrix
    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            scanf("%d", &matrix[i][j]);
        }
    }

    // A symmetric matrix must be square
    if (rows != cols)
    {
        printf("False");
        return 0;
    }

    // Check symmetry
    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            if (matrix[i][j] != matrix[j][i])
            {
                symmetric = 0;
            }
        }
    }

    if (symmetric == 1)
        printf("True");
    else
        printf("False");

    return 0;
}
