Q65: Search ina sorted array using binary search.*/
  #include <stdio.h>

int main() {
    int n, key;

    scanf("%d", &n);

    int arr[n];

    // Input sorted array
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Element to search
    scanf("%d", &key);

    int low = 0;
    int high = n - 1;
    int index = -1;

    // Binary Search
    while (low <= high) {

        int mid = (low + high) / 2;

        if (arr[mid] == key) {
            index = mid;
            break;
        }
        else if (arr[mid] < key) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    // Output
    if (index != -1) {
        printf("Found at index %d\n", index);
    }
    else {
        printf("-1\n");
    }
Q66: Insert an element in a sorted array at the appropriate position.
  #include <stdio.h>

int main() {
    int n, element;

    scanf("%d", &n);

    int arr[n + 1];

    // Input array
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Element to insert
    scanf("%d", &element);

    int i = n - 1;

    // Shift greater elements one position to the right
    while (i >= 0 && arr[i] > element) {
        arr[i + 1] = arr[i];
        i--;
    }

    // Insert element
    arr[i + 1] = element;

    n++;

    // Print updated array
    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);

        if (i < n - 1) {
            printf(" ");
        }
    }

    return 0;
}
