Q67: Insert an element in an array at a given position.*/
#include <stdio.h>

int main() {
    int n, position, element;

    scanf("%d", &n);

    int arr[n + 1];

    // Input array
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Input position and element
    scanf("%d %d", &position, &element);

    // Shift elements to the right
    for (int i = n; i > position; i--) {
        arr[i] = arr[i - 1];
    }

    // Insert element
    arr[position] = element;

    n++;

    // Print updated array
    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);

        if (i < n - 1) {
            printf(" ");
        }
    }

    return 0;
}
Q68: Delete an element from an array.
#include <stdio.h>

int main() {
    int n, position;

    scanf("%d", &n);

    int arr[n];

    // Input array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Input index to delete
    scanf("%d", &position);

    // Shift elements to the left
    for (int i = position; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }

    // Decrease array size
    n--;

    // Print updated array
    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);

        if (i < n - 1) {
            printf(" ");
        }
    }

    return 0;
}
