Q41: Write a program to swap the first and last digit of a number.

/*
#include <stdio.h>

int main() {
    int n, first, last, digits = 1, temp, result;

    scanf("%d", &n);

    temp = n;

    last = n % 10;

    while (temp >= 10) {
        temp = temp / 10;
        digits = digits * 10;
    }

    first = temp;

    result = n - first * digits;
    result = result - last;
    result = result + last * digits;
    result = result + first;

    printf("%d", result);

    return 0;
}
Q42: Write a program to check if a number is a perfect number.

/*
#include <stdio.h>

int main() {
    int n, i, sum = 0;

    scanf("%d", &n);

    for (i = 1; i < n; i++) {
        if (n % i == 0) {
            sum = sum + i;
        }
    }

    if (sum == n)
        printf("Perfect number");
    else
        printf("Not perfect number");

    return 0;
}
