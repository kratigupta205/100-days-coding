Q71: Read and print a matrix.
#include <stdio.h>

int main()
{
    int rows, cols;
    int matrix[10][10];
    int i, j;

    // Input number of rows and columns
    scanf("%d %d", &rows, &cols);

    // Input matrix elements
    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Print the matrix
    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            printf("%d ", matrix[i][j]);
        }
        printf("\n");
    }

    return 0;
}

Q72: Find the sum of all elements in a matrix.
#include <stdio.h>

int main()
{
    int rows, cols;
    int matrix[10][10];
    int i, j;
    int sum = 0;

    // Input rows and columns
    scanf("%d %d", &rows, &cols);

    // Input matrix elements
    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Find sum of all elements
    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            sum = sum + matrix[i][j];
        }
    }

    // Print sum
    printf("%d\n", sum);

    return 0;
}
