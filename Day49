Q97: Print the initials of a name.
#include <stdio.h>

int main()
{
    char name[100];
    int i;

    printf("Enter name: ");
    fgets(name, sizeof(name), stdin);

    // Print first initial
    printf("%c.", name[0]);

    // Find letters after spaces
    for(i = 1; name[i] != '\0'; i++)
    {
        if(name[i] == ' ' && name[i + 1] != ' ')
        {
            printf("%c.", name[i + 1]);
        }
    }

    return 0;
}
Q98: Print initials of a name with the surname displayed in full.
#include <stdio.h>
#include <string.h>

int main()
{
    char name[100];
    int i, lastSpace = -1;

    printf("Enter full name: ");
    fgets(name, sizeof(name), stdin);

    // Find the last space
    for(i = 0; name[i] != '\0'; i++)
    {
        if(name[i] == ' ')
        {
            lastSpace = i;
        }
    }

    // Print initials before surname
    printf("%c.", name[0]);

    for(i = 1; i < lastSpace; i++)
    {
        if(name[i] == ' ')
        {
            printf("%c.", name[i + 1]);
        }
    }

    // Print surname
    printf(" %s", &name[lastSpace + 1]);

    return 0;
}
